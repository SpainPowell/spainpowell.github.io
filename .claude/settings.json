{
  "permissions": {
    "deny": [
      "Read(./.env*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Edit(.claude/settings*.json)",
      "Edit(.claude/hooks/**)",
      "Edit(.github/workflows/**)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(rm -rf*)",
      "Bash(npm publish*)",
      "Bash(eas submit*)"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(npm run check*)",
      "Bash(npm test*)",
      "Bash(npx tsc*)",
      "Bash(npx vitest*)",
      "Bash(python3 -m pytest*)",
      "Bash(python3 -m unittest*)",
      "Bash(flake8*)",
      "Bash(python3 -m flake8*)",
      "Bash(python3 -m mypy*)",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/scripts/protect-files.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/scripts/branch-guard.sh"
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/scripts/secret-scan.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/scripts/format-changed.sh" },
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/scripts/lint-changed.sh" }
        ]
      }
    ]
  }
}
